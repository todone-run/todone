{
  "name": "@todone/plugin-figma",
  "version": "0.4.2",
  "type": "module",
  "description": "A todone plugin that will alert you when a comment in a Figma file has been resolved",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/todone-run/todone.git",
    "directory": "packages/plugin-figma"
  },
  "bugs": {
    "url": "https://github.com/todone-run/todone/issues"
  },
  "author": "Carlos Precioso <npm@precioso.design>",
  "license": "ISC",
  "packageManager": "yarn@4.18.1",
  "exports": {
    "types": "./dist/index.d.mts",
    "default": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit -p .",
    "dev": "tsdown --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "todone": "workspace:^"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@todone/internal-build": "workspace:*",
    "@types/node": "24.19.0",
    "msw": "3.0.2",
    "todone": "workspace:*",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "sideEffects": false
}
