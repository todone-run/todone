{
  "name": "@todone/plugin-github",
  "version": "0.8.0",
  "type": "module",
  "description": "A todone plugin that will alert you when an GitHub issue or pull request has been resolved",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/todone-run/todone.git",
    "directory": "packages/plugin-github"
  },
  "bugs": {
    "url": "https://github.com/todone-run/todone/issues"
  },
  "author": "Carlos Precioso <npm@precioso.design>",
  "license": "ISC",
  "packageManager": "yarn@4.18.0",
  "imports": {
    "#/package.json": "./package.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit -p .",
    "dev": "tsdown --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "todone": "workspace:^"
  },
  "dependencies": {
    "octokit": "^5.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@todone/internal-build": "workspace:^",
    "msw": "^2.15.0",
    "todone": "workspace:^",
    "tsdown": "^0.22.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "sideEffects": false
}
