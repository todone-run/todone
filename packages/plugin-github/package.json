{
  "name": "@todone/plugin-github",
  "version": "0.7.2",
  "type": "module",
  "description": "A todone plugin that will alert you when an GitHub issue or pull request has been resolved",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/todone-run/todone.git",
    "directory": "packages/plugin-github"
  },
  "bugs": {
    "url": "https://github.com/todone-run/todone/issues"
  },
  "author": "Carlos Precioso <npm@precioso.design>",
  "license": "ISC",
  "packageManager": "yarn@4.18.1",
  "imports": {
    "#/package.json": "./package.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit -p .",
    "dev": "tsdown --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "todone": "workspace:^"
  },
  "dependencies": {
    "octokit": "^5.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@todone/internal-build": "workspace:*",
    "msw": "3.0.1",
    "todone": "workspace:*",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "sideEffects": false
}
