{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor", "schedule:weekends"],
  "minimumReleaseAge": "7 days",
  "rangeStrategy": "bump",
  "postUpdateOptions": ["yarnDedupeHighest"],
  "packageRules": [
    {
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "widen",
    },
    {
      // *TODO https://github.com/TypeStrong/typedoc/issues/3098
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7",
    },
  ],
}
